node_modules
build
.svelte-kit
.git
.github
.claude

# Local env files: the image takes configuration through build args instead.
.env
.env.*
!.env.example

# Editor and OS noise
.vscode
.idea
.DS_Store
*.log
npm-debug.log*

# Not needed to build or serve the site
screenshots
*.zip
